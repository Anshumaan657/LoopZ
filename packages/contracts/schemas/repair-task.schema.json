{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "repairId": {
      "type": "string",
      "minLength": 1
    },
    "parentRunId": {
      "type": "string",
      "minLength": 1
    },
    "parentAssessmentId": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "unresolvedCriterionIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "preservedCriterionIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "failureEvidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EV-[0-9]{3}$"
      }
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "requiredRegressionChecks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stopWhen": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    }
  },
  "required": [
    "schemaVersion",
    "repairId",
    "parentRunId",
    "parentAssessmentId",
    "attempt",
    "unresolvedCriterionIds",
    "preservedCriterionIds",
    "failureEvidenceIds",
    "instructions",
    "requiredRegressionChecks",
    "stopWhen"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^AC-[0-9]{3}$"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1
    }
  },
  "$id": "https://loopz.dev/schemas/repair-task.schema.json",
  "title": "Repair Task 0.1"
}
